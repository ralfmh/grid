#include "../../src/map/map.nvgt"

void test_person_portal_freeze()
{
  string definition = "port fx0 fy0 tx3 ty0 pam pt0" + LINE_SEPARATOR
                      + "tile fx0 tx5 fy0 mlstone";
  Map map;
  string[] errors = map.Parse(definition);
  assert(errors.length() == 0, join(errors, ", "));
  map.CreateGrids();
  Person p(0, 0, map);
  p.ActivatePortal();
  assert(p.Move(Right) == Delayed);
  assert(p.AutoMoveState == Porting);
  p.AutoMove();
  assert(p.X == 1);
  p.AutoMove();
  assert(p.X == 2);
  p.AutoMove();
  assert(p.X == 3);
  assert(p.AutoMoveState == Standing);
}