#include "../../src/map/map.nvgt"

void test_person_portal_auto_move()
{
  string definition = "tile fx0 tx10 fy0 mlstone" + LINE_SEPARATOR
                      + "port fx1 fy0 tx4 ty0 pau pt0";
  Map map;
  string[] errors = map.Parse(definition);
  assert(errors.length() == 0, join(errors, ", "));
  map.CreateGrids();
  Person p(0, 0, map);
  p.Move(Right);
  assert(p.AutoMoveState == Porting);
  p.AutoMove();
  assert(p.X == 2);
  p.AutoMove();
  assert(p.X == 3);
  p.AutoMove();
  assert(p.X == 4);
  assert(p.AutoMoveState == Falling);
}