#include "../../src/map/map.nvgt"

void test_person_portal_simple()
{
  string definition = "port fx0 fy0 tx3 ty0 pam pt0";
  Map map;
  string[] errors = map.Parse(definition);
  assert(errors.length() == 0, join(errors, ", "));
  map.CreateGrids();
  Person p(0, 0, map);
  p.ActivatePortal();
  assert(p.AutoMoveState == Porting);
  p.AutoMove();
  assert(p.X == 1);
  p.AutoMove();
  assert(p.X == 2);
  p.AutoMove();
  assert(p.X == 3);
  assert(p.AutoMoveState == Falling);
}