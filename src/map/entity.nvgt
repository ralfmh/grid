#include "entity_type.nvgt"
#include "portal_activation.nvgt"

/*
** Represents an entity on the map.
*/
final class Entity
{
  string Content; // The material or literal value of the entity.

  int FromX;  // The minimum x position of the entity.

  int FromY;  // The minimum y position of the entity.

  PortalActivation PortalActivation;  // Portal activation mode.

  string PortalEnterSound;  // Played sound when the player enters the portal.

  string PortalExitSound; // Played sound when the player exits the portal.

  string PortalTravelSound; // Played sound while the player travels through the portal.

  int PortalTravelTime; // Time it takes in milliseconds to travel through the portal.

  int ToX;  // The maximum x position of the entity.

  int ToY;  // The maximum y position of the entity.

  EntityType Type;  // The type of the entity.
}